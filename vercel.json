{
  "version": 2,
  "rewrites": [
    { "source": "/.netlify/functions/models", "destination": "/api/models" },
    { "source": "/.netlify/functions/auth", "destination": "/api/auth" },
    { "source": "/.netlify/functions/callback", "destination": "/api/callback" },
    { "source": "/.netlify/functions/status", "destination": "/api/status" },
    { "source": "/.netlify/functions/notice", "destination": "/api/notice" },
    { "source": "/.netlify/functions/admin", "destination": "/api/admin" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
