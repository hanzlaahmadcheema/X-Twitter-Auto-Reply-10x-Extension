{
  "manifest_version": 3,
  "name": "HA ReplyX - AI-Powered Replies. Smarter X Engagement.",
  "version": "4.0.0",
  "description": "HA ReplyX: AI-Powered Replies. Smarter X Engagement. Premium context-aware, multilingual, and voice-enabled AI assistant for X (Twitter).",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self'  'unsafe-inline'; 'unsafe-eval' child-src 'self';"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "downloads",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://whatsapp.com/*",
    "https://x-twitter-auto-reply-10x-extension.vercel.app/*",
    "https://*.vercel.app/*",
    "https://accounts.google.com/*",
    "https://x-reply-auth-backend.netlify.app/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://api.edenai.run/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "js": [
        "assets/contentScript.bundle.js-loader-C9NQsKCM.js",
        "assets/selectionActions.js-loader-Bth4puJL.js"
      ],
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://web.whatsapp.com/*"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://web.whatsapp.com/*",
        "*://x.com/*"
      ],
      "resources": [
        "style.css",
        "popup.css",
        "libs/html2canvas.min.js",
        "fonts/*",
        "assets/rolldown-runtime-D9-fqq9M.js",
        "assets/contentScript.bundle.js-PbAwf3N-.js",
        "assets/selectionActions.js-C7JNaS0J.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "HA ReplyX",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
