{
  "name": "x-twitter-auto-reply-10x-extension",
  "version": "4.0.0",
  "description": "This Chrome extension helps users efficiently engage on Twitter with customizable features like auto-reply generation, alarm notifications, and more. Stay active, organized, and productive with ease!",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./chrome-extension/input.css -o ./chrome-extension/popup.css --minify",
    "watch:css": "tailwindcss -i ./chrome-extension/input.css -o ./chrome-extension/popup.css --watch",
    "build:admin": "cd admin-ui && npm install && npm run build",
    "build": "vite build && npm run build:admin",
    "build:clean": "rm -rf dist && vite build && npm run build:admin",
    "build:release": "npm run build:clean && node obfuscate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzlaahmadcheema/X-Twitter-Auto-Reply-10x-Extension.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hanzlaahmadcheema/X-Twitter-Auto-Reply-10x-Extension/issues"
  },
  "homepage": "https://github.com/hanzlaahmadcheema/X-Twitter-Auto-Reply-10x-Extension#readme",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "autoprefixer": "^10.4.23",
    "fs-extra": "^11.4.0",
    "javascript-obfuscator": "^5.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "vercel": "^59.1.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "postgres": "^3.4.9"
  }
}
