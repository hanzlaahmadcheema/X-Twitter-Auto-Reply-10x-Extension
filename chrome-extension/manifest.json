{
  "manifest_version": 3,
  "name": "Auto Reply 10x: AI Engagement Agent",
  "version": "4.0.0",
  "description": "Premium AI-powered engagement assistant for X (Twitter). Context-aware, multilingual, and voice-enabled.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self'  'unsafe-inline'; 'unsafe-eval' child-src 'self';"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "downloads",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://whatsapp.com/*",
    "https://x-twitter-auto-reply-10x-extension.vercel.app/*",
    "https://*.vercel.app/*",
    "https://accounts.google.com/*",
    "https://x-reply-auth-backend.netlify.app/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://api.edenai.run/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "contentScript.bundle.js",
        "selectionActions.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "style.css",
        "popup.css",
        "libs/html2canvas.min.js",
        "fonts/*"
      ],
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://web.whatsapp.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open Settings Sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}